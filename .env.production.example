# 生产环境配置模板：复制为服务器未提交的 .env；所有 TODO 完成前不得用于公网运行。
# TODO(部署前必须完成)：复制为服务器上的 .env，填写所有空值；不要提交真实 .env。
# 注意：本模板故意保留关键密钥为空，未完成配置时启动失败是预期的安全保护。

DEBUG=False
PRODUCTION=True

# TODO：使用安全随机值生成器生成至少 50 个字符的 Django SECRET_KEY。
SECRET_KEY=

# TODO：替换为实际域名；多个值用英文逗号分隔，不要写 http:// 或 https://。
ALLOWED_HOSTS=example.com,www.example.com
# TODO：替换为实际 HTTPS 站点地址；多个值用英文逗号分隔。
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# TODO：仅在域名、TLS 证书和 Nginx 的 443 配置都已完成后保持 True。
SECURE_SSL_REDIRECT=True
TRUST_PROXY_HEADERS=True
# TODO：完成 HTTPS、证书续期与子域名盘点后再改为 True；当前保持 False 是安全的部署前置条件。
ENABLE_HSTS=False

# Docker Compose 直接透传以下已编码 URL，不会从 MYSQL_PASSWORD 拼接，避免特殊字符解析错误。
# TODO：填写 mysql://<URL编码的用户名>:<URL编码的MYSQL_PASSWORD>@db:3306/<数据库名>。
# 密码中的 @、:、/、#、$、% 等字符必须百分号编码；此项留空时 Compose 应拒绝启动。
DATABASE_URL=
# TODO：设置 MySQL 强密码；该原始值仅供 db 容器初始化，不要直接复制到 DATABASE_URL。
MYSQL_DATABASE=shoplite
MYSQL_USER=shoplite
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 当前 Compose 内部 Redis 不对公网暴露；TODO：未来启用 Redis 认证时同步更新此 URL 和 Compose 配置。
REDIS_URL=redis://redis:6379/0
USE_REDIS_CACHE=True

# 当前生产环境必须保持模拟支付关闭。若在本机开发环境测试 mock webhook，
# SHOPLITE_PAYMENT_SECRET 必须为非空随机值；空值会拒绝所有回调（包括 DEBUG=True）。
# TODO：真实支付接入时按渠道的官方验签方案新增受保护的生产凭据；不要把 mock 密钥当作真实渠道凭据。
SHOPLITE_PAYMENT_SECRET=
ENABLE_MOCK_PAYMENT=False

# TODO：真实手机号注册/登录上线前，填写已审核的腾讯云短信配置。
# 当前 settings.py 在 PRODUCTION=True 时禁止 SMS_PROVIDER=console。
SMS_PROVIDER=tencent
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# 保留微信登录 UI，但在未完成 OAuth 配置前安全禁用。
# TODO：真正接入后同时填写两个应用凭据，再将 WECHAT_LOGIN_MODE 改为 allauth；缺少任一项会拒绝启动。
# 凭据由环境变量直接提供给 allauth，请勿在 Django 后台重复创建 weixin SocialApp。
WECHAT_LOGIN_MODE=disabled
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# TODO(AI)：完成供应商合规、密钥托管、脱敏、超时、成本和安全降级后再填写 provider 导入路径。
DISCOVERY_TEXT_INTENT_PROVIDER=
# TODO(图片识别)：实现并审核 ImageIntentProvider 后再填写；保持为空会让图片入口安全停用。
DISCOVERY_IMAGE_INTENT_PROVIDER=
DISCOVERY_TEXT_RATE_LIMIT=30
DISCOVERY_VOICE_RATE_LIMIT=30
DISCOVERY_IMAGE_RATE_LIMIT=10
DISCOVERY_RATE_LIMIT_WINDOW_SECONDS=300
